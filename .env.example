# ─── Single source of truth for ALL environment variables ──────────────────
#
# This file documents every variable used by the stack.
# It is the ONLY env file committed to the repo.
#
# Local bootstrap (recovery only — regular updates go through git/CI):
#   cp .env.example .env → fill in values → make bootstrap
#
# CI deploys (Forgejo Actions):
#   Variables: defined directly in .forgejo/workflows/deploy-*.yml
#   Secrets:   stored in Forgejo Secrets → ${{ secrets.XXX }} in the workflow
#   DO NOT paste real secrets in this file or any committed file.
#
# Forgejo Secrets to create (Settings → Actions → Secrets):
#   BASE_DOMAIN          votre-domaine.com        (ex: example.com)
#   PUBLIC_IP            IP publique du VPS
#   ACME_EMAIL           votre@email.com
#   FORGEJO_ADMIN_EMAIL  admin@votre-domaine.com
#   RCLONE_CONFIG_TOKEN  {"access_token":"...","token_type":"Bearer",...}

# --- Email for Let's Encrypt certificates ---
ACME_EMAIL=YOUR_EMAIL@example.com

# --- Forgejo domain (only reachable through Tailscale; DNS must resolve
# publicly to the VPS for Traefik HTTP-01 challenge) ---
FORGEJO_DOMAIN=git.YOUR_DOMAIN.com

# --- Headscale (self-hosted Tailscale control server) ---
HEADSCALE_DOMAIN=headscale.YOUR_DOMAIN.com
HEADSCALE_DNS_DOMAIN=tailnet.YOUR_DOMAIN.com
# HEADSCALE_AUTHKEY=       # single-use pre-auth key (generated on server)

# --- VPS addresses ---
PUBLIC_IP=YOUR_VPS_PUBLIC_IP

# --- Docker Compose project name ---
# Namespaces container, network and volume names so prod and dev can coexist
# on the same VPS. Ansible pins it automatically (group_vars), but set it here
# for documentation / local docker-compose runs.
COMPOSE_PROJECT_NAME=ia-stack

# --- Docker image for Ansible ---
ANSIBLE_IMAGE=my-ansible
ANSIBLE_USER=root
SERVER_HOST=YOUR_VPS_PUBLIC_IP
SERVER_USER=deploy

# --- Pinned service images ---
TRAEFIK_IMAGE=traefik:v3.7.11
HEADSCALE_IMAGE=headscale/headscale:0.29.3
POSTGRES_IMAGE=postgres:16.4
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:10.0.0

# --- PostgreSQL database for Forgejo ---
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo

# --- Forgejo administrator ---
FORGEJO_ADMIN_USERNAME=forgejo-admin
FORGEJO_ADMIN_EMAIL=your.admin@example.com

# --- Backups (rclone → Google Drive) ---
# RCLONE_REMOTE is derived automatically per environment:
#   prod -> gdrive:forgejo-backups
#   dev  -> gdrive:forgejo-backups-dev
# Override here only to use a custom folder.
# RCLONE_REMOTE=gdrive:forgejo-backups
# BACKUP_RETENTION_DAYS=14
# RCLONE_CONFIG_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}