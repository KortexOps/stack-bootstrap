# --- Email for Let's Encrypt certificates ---
ACME_EMAIL=YOUR_EMAIL@example.com

# --- Forgejo domain (reachable only through the tailnet; needs a hosts entry
# or MagicDNS on clients) ---
FORGEJO_DOMAIN=git.YOUR_DOMAIN.com

# --- Headscale (private network, self-hosted Tailscale control server) ---
# Public HTTPS domain of the headscale server (resolves publicly to the VPS).
HEADSCALE_DOMAIN=headscale.YOUR_DOMAIN.com

# --- VPS addresses ---
# PUBLIC_IP is overwritten from inventory.yml by Ansible.
PUBLIC_IP=YOUR_VPS_PUBLIC_IP

# --- Docker image for Ansible ---
ANSIBLE_IMAGE=my-ansible

# --- PostgreSQL database for Forgejo ---
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo

# --- Forgejo administrator ---
FORGEJO_ADMIN_USERNAME=forgejo-admin
FORGEJO_ADMIN_EMAIL=your.admin@example.com
# The administrator password is generated automatically by Ansible and stored securely on the VPS.